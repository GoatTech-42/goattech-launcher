# Generated files that tests compare byte for byte with what they generate: LF on every OS, also
# where Git for Windows' core.autocrlf would check them out with CRLF.
docs/launcher-commands.md text eol=lf
docs/engine/horizon-ctl-commands.md text eol=lf
crates/horizon-theme/tokens.css text eol=lf
docs/engine/api/*-reference.md text eol=lf
# Generated by `cargo run -p xtask -- mod-api`; `--check` compares them byte for byte.
crates/horizon-client/src/mod_api/generated.rs linguist-generated=true text eol=lf
crates/horizon-client/src/mod_api/generated_host.rs linguist-generated=true text eol=lf
crates/horizon-client/src/game/mod_api_host_generated.rs linguist-generated=true text eol=lf
crates/horizon-client-render/src/gfx/native_render/generated.rs linguist-generated=true text eol=lf

# Pinned notice texts whose SHA-256 the packager checks (tools/dependency_notices.py) and the
# covered source it copies: stored and checked out byte for byte, never CRLF-converted by
# Git for Windows' core.autocrlf.
packaging/goattech/upstream-notices/** -text
packaging/goattech/covered-source/** -text

# Hash-qualified synthetic import fixtures must survive Windows checkout byte for byte.
docs/qa/import-fixture/** -text
