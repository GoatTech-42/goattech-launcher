diff --git a/tmp/routecap-source/launcher/src/capture_routes.rs b/launcher/src/capture_routes.rs
new file mode 100644
index 0000000..ff7bfcf
--- /dev/null
+++ b/launcher/src/capture_routes.rs
@@ -0,0 +1,66 @@
+//! Runner-only synthetic rendering seam. This file is never part of a shipping source tip.
+use super::*;
+impl Launcher {
+    pub(super) fn capture_route(&mut self, cx: &mut Context<Self>) -> Option<Div> {
+        let route = std::env::var("GOAT_CAPTURE_ROUTE").ok()?;
+        let home = backend::game_home();
+        let body = match route.as_str() {
+            "export" => {
+                if self.export.is_none() {
+                    self.toggle_export();
+                }
+                self.export_panel(cx)?
+            }
+            "launch" => {
+                if self.launch.is_none() {
+                    self.toggle_launch();
+                }
+                self.launch_panel(cx)?
+            }
+            "skin" => {
+                if self.skin.is_none() {
+                    self.open_skin("Capture_Player".into());
+                }
+                self.skin_panel(cx)?
+            }
+            "console" => {
+                if self.prepare_log.is_empty() {
+                    self.prepare_log.extend(
+                        (1..=40)
+                            .map(|n| format!("[synthetic {n:02}] no game was run; capture only")),
+                    );
+                }
+                self.console_section(cx)?.1
+            }
+            "native-log" => {
+                self.native_log.open = true;
+                self.native_log.stale = false;
+                self.native_log.loaded = Some(Ok(native_log_page::Log::capture_fixture()));
+                div().child(text(theme::TITLE).child("Synthetic native log overlay"))
+            }
+            "instance-mods" => {
+                self.instance_mods.capture_fixture(home);
+                self.instance_mods_tab(cx).1
+            }
+            "packs" => div().child(self.packs_section(cx)?.1),
+            "world-datapacks" => {
+                let world = horizon_launcher::worlds::list(&home).into_iter().next()?;
+                if !self.world_packs_open(&world) {
+                    self.toggle_world_packs(&world);
+                }
+                self.world_packs_panel(&world, cx)?
+            }
+            "internet" => self.capture_internet(cx),
+            "modpack-detail" => self.imported_packs(cx),
+            _ => panic!("unsupported runner-only capture route"),
+        };
+        Some(
+            div()
+                .flex()
+                .flex_col()
+                .gap(px(theme::chrome(20.)))
+                .child(text(theme::TITLE).child(format!("INSTRUMENTED synthetic state: {route}")))
+                .child(body),
+        )
+    }
+}
